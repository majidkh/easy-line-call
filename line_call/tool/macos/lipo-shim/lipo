#!/bin/sh
# Local workaround (verification only): Xcode 27's lipo accepts a single arch
# per -verify_arch, but this Flutter SDK passes all archs in one call.
# Loop single-arch verifies; everything else goes straight through.
if [ "$2" = "-verify_arch" ] && [ $# -gt 3 ]; then
  f="$1"; shift 2
  for a in "$@"; do
    /usr/bin/lipo "$f" -verify_arch "$a" || exit $?
  done
  exit 0
fi
exec /usr/bin/lipo "$@"
